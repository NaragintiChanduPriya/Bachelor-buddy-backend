# BachelorBuddy backend configuration. Copy to .env and fill in the blanks.
# .env is git-ignored. Never commit real secrets.

# --- PostgreSQL admin account (used ONLY by scripts/setup_db.py and scripts/reset_db.py) ---
# Neon: the owner role from the connection string (e.g. neondb_owner), and the DIRECT host,
# which is the pooler host without "-pooler". Local: localhost and the postgres superuser.
POSTGRES_HOST=ep-xxxx.c-2.ap-southeast-1.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=neondb_owner
POSTGRES_ADMIN_PASSWORD=
# "require" for Neon (TLS only). Use "prefer" for a local server.
POSTGRES_SSLMODE=require

# --- App database and role (created by scripts/setup_db.py; the API connects as this role) ---
APP_DB_NAME=bachelorbuddy
APP_DB_USER=bachelorbuddy_app
# At least 12 random characters; Neon rejects weak passwords for roles created by SQL.
APP_DB_PASSWORD=change-me
# Async URLs used by the API and the tests. Keep the password in sync with APP_DB_PASSWORD.
# Neon: use the POOLED host (with "-pooler") and end with ?ssl=require. Migrations run over
# POSTGRES_HOST automatically. Local: localhost, and no ?ssl=require.
DATABASE_URL=postgresql+asyncpg://bachelorbuddy_app:change-me@ep-xxxx-pooler.c-2.ap-southeast-1.aws.neon.tech:5432/bachelorbuddy?ssl=require
TEST_DATABASE_URL=postgresql+asyncpg://bachelorbuddy_app:change-me@ep-xxxx-pooler.c-2.ap-southeast-1.aws.neon.tech:5432/bachelorbuddy_test?ssl=require

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Password for the seeded demo account arjun@demo.com (8+ characters)
DEMO_USER_PASSWORD=change-me
# bcrypt cost (12 is ~250 ms per hash)
BCRYPT_ROUNDS=12
# DEVELOPMENT ONLY: requests without a token act as this user, so the frontend works before
# login is added. Refused when APP_ENV=production. Leave empty otherwise.
DEV_AUTH_BYPASS_EMAIL=

# --- AI agents (Groq) ---
GROQ_API_KEY=
# Main model for the Concierge orchestrator; must support tool calling.
GROQ_MODEL=openai/gpt-oss-120b
# Smaller model for single-tool specialist tasks and notification wording.
GROQ_FAST_MODEL=openai/gpt-oss-20b
# "llm" uses Groq (falls back to rules per request on failure); "rules" needs no API key.
AGENT_MODE=rules
GROQ_TIMEOUT_SECONDS=30
# Concierge turns per message; earlier messages sent as context; tokens per completion.
AGENT_MAX_ITERATIONS=4
AGENT_HISTORY_MESSAGES=6
AGENT_MAX_TOKENS=900
# Token saver for the free tier: the Concierge calls specialist tools directly.
AGENT_DIRECT_TOOLS=false

# --- HTTP ---
# Comma-separated list of allowed browser origins. "*" is rejected.
CORS_ORIGINS=http://localhost:5173
# In-memory rate limits: auth per client IP, chat per signed-in user.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=20/minute

# --- Runtime (optional; these are the defaults) ---
# "production" adds the HSTS header. The API refuses to start with a placeholder JWT_SECRET.
APP_ENV=development
# Every contract endpoint lives under this prefix; the frontend's VITE_API_BASE_URL ends with it.
API_PREFIX=/api
LOG_LEVEL=INFO
# "json" (one object per line, for log tools) or "text" (for reading in a terminal).
LOG_FORMAT=json

# --- Data and time ---
SEED_VALUE=42
TZ=Asia/Kolkata
# "real" uses the wall clock (production requires it). "demo" freezes "now" at the 15th of the
# current month, 12:30 IST. "fixed" pins CLOCK_FIXED_AT (the frontend's e2e run uses it).
CLOCK_MODE=real
# CLOCK_FIXED_AT=2026-11-15T07:00:00Z
